# Copy to .env.local and fill in. .env.local is never committed; this template is.
# Optional settings stay commented out until set: an empty value is not the same as unset.

# The Beyond Service API. Required: the admin has no other data, and won't start without it.
BS_API_URL=https://backend-a5um.onrender.com

# Development only. 1: the terminal logs what every API call sent and got back, not just refusals.
# BS_API_DEBUG=1
